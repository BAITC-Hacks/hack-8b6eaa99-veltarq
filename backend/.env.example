# Server-only LLM provider. GPT-6 uses the OpenAI Responses API.
# Copy this file to backend/.env; npm run dev / dev:backend / start load it.
# Never put the API key in a VITE_* variable, frontend file, URL, or Git.
# OpenAI example (or replace URL/model with your compatible provider):
VELTARQ_LLM_BASE_URL=https://api.openai.com/v1
VELTARQ_LLM_MODEL=gpt-6-luna
# responses for OpenAI GPT-6 Luna / Astra; chat_completions for compatible providers.
VELTARQ_LLM_API_MODE=responses
# Required for AI. Leave empty to use "Автоматическое объяснение без ИИ".
VELTARQ_LLM_API_KEY=
# Per-request timeout in seconds; use 1–30 (browser request timeout is 45s).
VELTARQ_LLM_TIMEOUT_SECONDS=20

# SQLite database path.
VELTARQ_DB_PATH=data/veltarq.db

# Comma-separated browser origins. These are the defaults when unset.
VELTARQ_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Optional: serve the built website and API from one FastAPI origin.
# Run npm run build in the repository root before enabling this.
VELTARQ_SERVE_FRONTEND=false
# Optional absolute path; defaults to ../dist relative to this backend directory.
# VELTARQ_FRONTEND_DIR=
