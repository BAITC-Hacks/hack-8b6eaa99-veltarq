VITE_2GIS_KEY=
# API prefix. Empty/unset uses the same origin via the Vite proxy or FastAPI.
VITE_API_BASE_URL=/api/v1
# Development proxy destination (server-only; never included in the browser bundle).
BACKEND_URL=http://127.0.0.1:8000
# AI provider settings belong ONLY in backend/.env (see backend/.env.example).
# Do not add LLM credentials or a VITE_* LLM key here.
