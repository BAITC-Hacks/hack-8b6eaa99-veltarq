{
  "contract": {
    "authority": {
      "contentRepartition": "within-surface-only",
      "interactionModel": "locked",
      "pageStructure": "revisable"
    },
    "capabilityRequirements": [
      {
        "capability": "Показывать Астану на ограниченной городской карте.",
        "complexity": "complex",
        "constraints": [
          "React + TypeScript + MapLibre GL JS + OpenFreeMap; geographic base remains a background.",
          "Preserve maxBounds [[71.20,51.035],[71.63,51.275]], whole-city framing [[71.27,51.065],[71.56,51.22]], zoom controls and whole-city reset.",
          "Do not mutate OpenStreetMap or rebuild cartographic tiles."
        ],
        "id": "bounded-city-map",
        "ownerObjectId": "game-zones",
        "required": true,
        "surfaceIds": [
          "astana-map"
        ]
      },
      {
        "capability": "Выбирать и подсвечивать пять игровых зон с карточкой района.",
        "complexity": "bounded",
        "constraints": [
          "Exact dataset districtId values: Есиль, Алматы, Сарыарка, Байконур, Нура; names, IDs and polygon geometry remain versioned in src/data.",
          "Selection from polygon or accessible district control highlights the same zone and updates its contextual detail; reset clears selection.",
          "Every district remains selectable on desktop and mobile; decorative numbering must not replace districtId."
        ],
        "id": "five-zone-selection",
        "ownerObjectId": "district-scenario",
        "required": true,
        "surfaceIds": [
          "astana-map"
        ]
      },
      {
        "capability": "Показывать условную школу и парк в каждом районе.",
        "complexity": "bounded",
        "constraints": [
          "Preserve all ten project points: one school and one park for each of the five exact districtId values.",
          "Project placement and game-zone boundaries are explicitly labelled as demonstration data; retain project inspection and names."
        ],
        "id": "demo-projects",
        "ownerObjectId": "demo-projects",
        "required": true,
        "surfaceIds": [
          "astana-map"
        ]
      },
      {
        "capability": "Показывать здания, зелёные участки, транспорт и сервисы отдельными игровыми слоями.",
        "complexity": "complex",
        "constraints": [
          "Preserve building and green polygons, transport lines and service point symbols from decisions.geojson.",
          "Layers and symbols are legible over the geographic background and have a meaningful legend."
        ],
        "id": "decision-overlays",
        "ownerObjectId": "decision-layers",
        "required": true,
        "surfaceIds": [
          "astana-map"
        ]
      },
      {
        "capability": "Переключать До и После с согласованным изменением игровых слоёв и показателей.",
        "complexity": "bounded",
        "constraints": [
          "Before hides added project/decision layers and uses before metrics; After shows them and uses after metrics.",
          "Keep geographic base, selected district and current camera while switching; show the active mode accessibly.",
          "Preserve city mean index and district index, newSchools and newParks values without inventing new numerical claims."
        ],
        "id": "scenario-switch",
        "ownerObjectId": "district-scenario",
        "required": true,
        "surfaceIds": [
          "astana-map"
        ]
      },
      {
        "capability": "Использовать одну сохранённую версию геометрии и показателей.",
        "complexity": "bounded",
        "constraints": [
          "Keep districts.geojson, metrics.json, projects.geojson and decisions.geojson as one shared repository dataset.",
          "Baseline indices remain Есиль=62.99, Алматы=57.06, Сарыарка=54.65, Байконур=56.63, Нура=49.18.",
          "After indices remain Есиль=68.4, Алматы=63.2, Сарыарка=60.1, Байконур=62.7, Нура=57.3; before counts=0 and after counts=1 school and 1 park per district."
        ],
        "id": "shared-data",
        "ownerObjectId": "astana-game",
        "required": true,
        "surfaceIds": [
          "astana-map"
        ]
      },
      {
        "capability": "Сохранять читаемость и управление на desktop и mobile.",
        "complexity": "bounded",
        "constraints": [
          "UI content is Russian; chosen font must render Russian and Kazakh Cyrillic, including Ә Ғ Қ Ң Ө Ұ Ү Һ І.",
          "Keyboard focus, labelled controls and selected state remain visible; mobile preserves map and all five district choices.",
          "Loading or map failure must not masquerade as successful cartography; local district metrics remain inspectable where possible."
        ],
        "id": "legible-responsive-ui",
        "ownerObjectId": "district-scenario",
        "required": true,
        "surfaceIds": [
          "astana-map"
        ]
      }
    ],
    "checkpointMode": "review-before-implementation",
